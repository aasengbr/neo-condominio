{
  "name": "NEO_Condomínio",
  "short_name": "NEO",
  "description": "Registro de ocorrências, compromissos e gastos do condomínio — foto, vídeo, voz e texto.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F5F7",
  "theme_color": "#1E4E8C",
  "lang": "pt-BR",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [ { "name": "media", "accept": ["image/*", "video/*", "audio/*"] } ]
    }
  }
}
